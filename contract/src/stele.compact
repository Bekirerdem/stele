// STELE - a public record of accountability
//
// An institution records its question, who may answer it, when it closes and
// what it promises to do about the outcome, in a way it cannot take back.
// Respondents stay invisible; the count and the promise are publicly verifiable.
//
// SPDX-License-Identifier: Apache-2.0

pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Phases
//
// REGISTRATION: the eligibility tree grows, no answers are accepted.
// VOTING:       the root is FROZEN, only participation is accepted.
// CLOSED:       the count is final.
//
// Freezing the root closes three holes at once: proofs invalidated by a root
// that shifts mid-flight, ghost entries added after the operator has seen
// where the round is heading, and differencing attacks that isolate a single
// person by running the same question against two slightly different sets.
// ---------------------------------------------------------------------------
export enum Phase {
  REGISTRATION,
  VOTING,
  CLOSED
}

// ---------------------------------------------------------------------------
// What the round commits to, written once at construction (sealed).
// Once a round is open its question, its audience and its promise are fixed.
// ---------------------------------------------------------------------------

// Position in the registry. A gap in the sequence is an unannounced round.
export sealed ledger roundNumber: Uint<64>;

// Canonical hash of the question text and its option labels.
// Without the question on chain, "tally[2] = 47" says nothing, and the
// institution could relabel the question afterwards and present the same
// count as belonging to something far more flattering.
export sealed ledger questionHash: Bytes<32>;

// Valid answers are 0 .. optionCount-1
export sealed ledger optionCount: Uint<8>;

// THE PROMISE - the heart of the product.
// The institution engraves not only its question but what it will do about
// the answer: "if it comes in below this threshold, here is my commitment".
export sealed ledger promiseHash: Bytes<32>;
export sealed ledger promiseThreshold: Uint<8>;

// k-anonymity floor. A round that draws fewer participants than this cannot
// be closed. In a small group a moving tally can be traced back to a person,
// so this is a circuit rule rather than a product setting.
export sealed ledger minParticipants: Uint<16>;

// The operator's committed identity. Only this identity can move the phase.
export sealed ledger operatorId: Bytes<32>;

// ---------------------------------------------------------------------------
// Mutable state
// ---------------------------------------------------------------------------

export ledger phase: Phase;

// The eligibility tree. HistoricMerkleTree because checkRoot also accepts
// PAST roots: a path produced by an early registrant stays valid even after
// the tree has grown.
export ledger eligibility: HistoricMerkleTree<16, Bytes<32>>;

// How many registered. Public, so a padded roster is socially visible.
export ledger eligibleCount: Counter;

// Spent uniqueness tags. A Set is safe here because a nullifier is a value
// that is meant to be public. (A Set must NOT be used for the membership
// proof - it reveals which element was tested.)
export ledger nullifiers: Set<Bytes<32>>;

// Per-option tally.
export ledger tally: Map<Uint<8>, Counter>;

// Total participation.
export ledger participantCount: Counter;

// ---------------------------------------------------------------------------
// Witnesses - held only on the participant's own device, never on chain.
// ---------------------------------------------------------------------------

// The eligibility secret. Generated on the participant's device; the
// institution only ever receives the commitment H(secret). Whoever knows a
// secret can precompute its nullifiers, so a centrally issued secret would
// turn the public tag list into a roster of names.
witness localSecret(): Bytes<32>;

// The commitment's membership path in the tree.
witness eligibilityPath(cm: Bytes<32>): MerkleTreePath<16, Bytes<32>>;

// ---------------------------------------------------------------------------
// Derivations - domain separation is mandatory
// ---------------------------------------------------------------------------

// commitment = H("stele:cm:", secret)
export circuit commitmentOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "stele:cm:"), secret]);
}

// nullifier = H("stele:nul:", roundNumber, secret)
// The round number enters the domain separator, so the same secret yields
// unrelated tags in different rounds and participation cannot be linked
// across the registry.
export circuit nullifierOf(secret: Bytes<32>, round: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "stele:nul:"), round, secret]);
}

// operator identity = H("stele:op:", secret)
export circuit operatorIdOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "stele:op:"), secret]);
}

// ---------------------------------------------------------------------------
// Construction
// ---------------------------------------------------------------------------
constructor(
  round: Uint<64>,
  question: Bytes<32>,
  options: Uint<8>,
  promise: Bytes<32>,
  threshold: Uint<8>,
  minCount: Uint<16>,
  operator: Bytes<32>
) {
  roundNumber = disclose(round);
  questionHash = disclose(question);
  optionCount = disclose(options);
  promiseHash = disclose(promise);
  promiseThreshold = disclose(threshold);
  minParticipants = disclose(minCount);
  operatorId = disclose(operator);
  phase = Phase.REGISTRATION;
}

// ---------------------------------------------------------------------------
// Circuits
// ---------------------------------------------------------------------------

// Register. The participant submits a commitment produced on their own
// device. The secret itself never arrives here.
export circuit register(cm: Bytes<32>): [] {
  assert(phase == Phase.REGISTRATION, "Round is not accepting registrations");
  eligibility.insert(disclose(cm));
  eligibleCount.increment(1);
}

// Close registration and open voting. The root freezes at this point.
export circuit openVoting(): [] {
  assert(phase == Phase.REGISTRATION, "Round is not in registration phase");
  assert(operatorId == operatorIdOf(localSecret()), "Only the operator can open voting");
  phase = Phase.VOTING;
}

// Participate. What the circuit proves:
//   I know the secret behind a commitment in the eligibility tree
//   AND my tag for this round has not been spent
//   AND my answer is within range.
// No identity reaches the ledger at any point.
export circuit participate(choice: Uint<8>): [] {
  assert(phase == Phase.VOTING, "Round is not open for voting");
  assert(choice < optionCount, "Choice out of range");

  const secret = localSecret();
  const cm = commitmentOf(secret);
  const path = eligibilityPath(cm);

  // Both conditions are required. checkRoot alone only answers "is this a
  // root this tree has had", not "is the leaf mine" - on its own an attacker
  // could pass with a valid but unrelated leaf.
  assert(
    eligibility.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))) && cm == path.leaf,
    "Not an eligible participant"
  );

  const nul = nullifierOf(secret, roundNumber as Field as Bytes<32>);
  assert(!nullifiers.member(disclose(nul)), "Already participated in this round");
  nullifiers.insert(disclose(nul));

  if (!tally.member(disclose(choice))) {
    tally.insert(disclose(choice), default<Counter>);
  }
  tally.lookup(disclose(choice)).increment(1);
  participantCount.increment(1);
}

// Close the round. A round below the k-anonymity floor cannot be closed:
// with too few participants the tally can be traced back to a person.
export circuit closeRound(): [] {
  assert(phase == Phase.VOTING, "Round is not open");
  assert(operatorId == operatorIdOf(localSecret()), "Only the operator can close the round");
  assert(participantCount >= minParticipants as Uint<64>, "Participation below the anonymity threshold");
  phase = Phase.CLOSED;
}
