{
  "name": "stele",
  "version": "0.2.0",
  "description": "Ask the questions people can't answer honestly. Members answer without fear; answers are provably from real members, one per person, and can't be quietly buried. Built on Midnight.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/stele.compact contract/managed/stele",
    "compile:fast": "compact compile --skip-zk contract/stele.compact contract/managed/stele",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:sim": "vitest run --passWithNoTests .sim.test.ts",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "wait:dust": "vite-node scripts/wait-for-dust.ts",
    "stele": "vite-node scripts/cli.ts --",
    "shield:eval": "vite-node scripts/shield-eval.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@nearai/inference-sdk": "0.1.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite": "6.4.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/zkir-v3": "3.2.1"
  }
}
