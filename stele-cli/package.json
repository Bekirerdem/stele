{
  "name": "@midnight-ntwrk/stele-cli",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -R ../contract/src/managed dist/contract/src/managed",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint src",
    "prepack": "npm run build",
    "standalone": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/standalone.ts",
    "preview-remote": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preview.ts",
    "preprod-remote": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preprod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:preprod": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/deploy-round.ts",
    "balance": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/check-balance.ts",
    "addresses": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/show-addresses.ts",
    "verify": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/verify-round.ts"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.3.0"
  }
}
